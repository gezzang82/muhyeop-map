#!/bin/bash
# 무협맵 로컬 크롤러 — 이 파일을 더블클릭하면 수집+자동등록이 시작됩니다.
# 멈추려면 이 창에서 Control+C 를 누르거나 창을 닫으세요.
cd "$(dirname "$0")/.."
echo "무협맵 크롤러를 시작합니다… 지역: 서울·경기·부산·인천 (멈추려면 Control+C)"
# 인자 없으면 4개 지역 전체. 특정 지역만 하려면 인자로 지정 가능(예: 크롤러 실행 시 인자 서울).
node scripts/crawl-worker.js "${@:-서울,경기,부산,인천}"
echo ""
echo "크롤러가 종료됐습니다. 이 창은 닫으셔도 됩니다."
read -n 1 -s -r -p "아무 키나 누르면 닫힙니다…"
