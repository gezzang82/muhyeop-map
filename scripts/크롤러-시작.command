#!/bin/bash
# 무협맵 로컬 크롤러 — 이 파일을 더블클릭하면 수집+자동등록이 시작됩니다.
# 멈추려면 이 창에서 Control+C 를 누르거나 창을 닫으세요.
cd "$(dirname "$0")/.."
# ⚠️ 이미 돌고 있는 크롤러가 있으면 먼저 종료(더블클릭으로 2개가 겹쳐 돌면 오토파일럿이 같은 매장을 2중 등록 → 중복매장).
# 항상 1개만 유지: 재시작은 이 파일만 다시 실행하면 됨(옛 것 수동 종료 불필요).
EXIST=$(pgrep -f 'node scripts/crawl-worker.js')
if [ -n "$EXIST" ]; then
  echo "기존 크롤러를 종료하고 새로 시작합니다 (기존 PID: $(echo $EXIST | tr '\n' ' '))…"
  pkill -f 'node scripts/crawl-worker.js'
  sleep 2
fi
echo "무협맵 크롤러를 시작합니다… 전국(서울·경기·부산·인천·대구·광주·대전·강원·경북·경남·제주·충청·전라) (멈추려면 Control+C)"
# 인자 없으면 전국. 특정 지역만 하려면 인자로 지정 가능(예: 서울,경기).
# caffeinate: 크롤러 도는 동안 잠자기 방지. -d(디스플레이)·-i(유휴)·-m(디스크)·-s(시스템)·-u(사용자활동).
# ⚠️ -s(시스템 절전)는 AC 전원에서만 유효 → 무인 수집은 충전기 꽂아두는 걸 권장. 뚜껑 닫으면 무조건 잠듦.
caffeinate -dimsu node scripts/crawl-worker.js "${@:-서울,경기,부산,인천,대구,광주,대전,강원,경북,경남,제주,충청,전라}"
echo ""
echo "크롤러가 종료됐습니다. 이 창은 닫으셔도 됩니다."
read -n 1 -s -r -p "아무 키나 누르면 닫힙니다…"
