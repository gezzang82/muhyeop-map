{
  "functions": {
    "api/campaigns.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }]
    },
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }]
    }
  ],
  "crons": [
    { "path": "/api/campaigns?action=igcron", "schedule": "0 2 * * *" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://muhyeop.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/r/:region", "destination": "/api/places?seo=region&region=:region" },
    { "source": "/p/:id", "destination": "/api/places?seo=place&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/places?seo=sitemap" }
  ]
}
